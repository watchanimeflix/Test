rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow write: if true;
    }
    
    // Allow anyone to read claims (announcements when someone claims reward)
    match /claims/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow anyone to read announcements
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.email == "shadowtrimz@gmail.com";
    }
    
    // Allow anyone to read events (including event multiplier)
    match /events/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.email == "shadowtrimz@gmail.com";
    }
    
    match /{document=**} {
      allow read, write: if request.auth.token.email == "shadowtrimz@gmail.com";
    }
  }
}
